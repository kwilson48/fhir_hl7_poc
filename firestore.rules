rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is user-scoped: you can only touch your own subtree.
    // This shape scales horizontally — no cross-user queries, no hot docs.
    // Writes are schema-validated: allowed keys only, with type/range checks.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && validUser();

      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && validAttempt();
      }

      match /checkins/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && validCheckIn(dateKey);
      }
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser() {
      let data = request.resource.data;
      return request.method == 'delete'
          || (data.keys().hasOnly([
                'displayName', 'weeklySpendUsd', 'drinksPerWeek', 'onboarded',
                'milestoneAlerts', 'dailyReminder', 'reminderHour',
                'supportContactName', 'supportContactPhone', 'updatedAt'
              ])
              && (!('displayName' in data) || data.displayName == null
                  || (data.displayName is string && data.displayName.size() <= 200))
              && (!('weeklySpendUsd' in data)
                  || (data.weeklySpendUsd is int
                      && data.weeklySpendUsd >= 0 && data.weeklySpendUsd <= 100000))
              && (!('drinksPerWeek' in data)
                  || (data.drinksPerWeek is int
                      && data.drinksPerWeek >= 0 && data.drinksPerWeek <= 1000))
              && (!('onboarded' in data) || data.onboarded is bool)
              && (!('milestoneAlerts' in data) || data.milestoneAlerts is bool)
              && (!('dailyReminder' in data) || data.dailyReminder is bool)
              && (!('reminderHour' in data)
                  || (data.reminderHour is int
                      && data.reminderHour >= 0 && data.reminderHour <= 23))
              && (!('supportContactName' in data) || data.supportContactName == null
                  || (data.supportContactName is string
                      && data.supportContactName.size() <= 200))
              && (!('supportContactPhone' in data) || data.supportContactPhone == null
                  || (data.supportContactPhone is string
                      && data.supportContactPhone.size() <= 50))
              && (!('updatedAt' in data) || data.updatedAt is timestamp));
    }

    function validAttempt() {
      let data = request.resource.data;
      return request.method == 'delete'
          || (data.keys().hasOnly([
                'startDate', 'goalDays', 'endedAt', 'endReason', 'createdAt'
              ])
              && data.startDate is timestamp
              && data.goalDays is int
              && data.goalDays > 0
              && data.goalDays <= 366
              && (!('endedAt' in data) || data.endedAt == null
                  || data.endedAt is timestamp)
              && (!('endReason' in data) || data.endReason == null
                  || data.endReason in ['reset', 'completed'])
              && (!('createdAt' in data) || data.createdAt is timestamp));
    }

    function validCheckIn(dateKey) {
      let data = request.resource.data;
      return request.method == 'delete'
          || (dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && data.keys().hasOnly(['mood', 'craving', 'note', 'updatedAt'])
              && data.mood is int && data.mood >= 0 && data.mood <= 4
              && data.craving is int && data.craving >= 0 && data.craving <= 4
              && (!('note' in data) || data.note == null
                  || (data.note is string && data.note.size() <= 2000))
              && (!('updatedAt' in data) || data.updatedAt is timestamp));
    }
  }
}
